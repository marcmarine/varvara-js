{
  "$schema": "https://biomejs.dev/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useButtonType": "off",
        "useValidAnchor": "off",
        "noAmbiguousAnchorText": "off",
        "noNoninteractiveElementToInteractiveRole": "off"
      },
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "off",
        "noUnknownTypeSelector": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noDoubleEquals": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "warn",
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/.astro", "!**/.turbo", "!**/public/**/*.svg"]
  }
}
